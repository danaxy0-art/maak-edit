<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer app data. The saved Supabase login
     session must not be restored onto a new install, where it is no longer
     valid and makes the app show "Could not load your account". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
